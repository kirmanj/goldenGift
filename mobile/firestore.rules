rules_version = '2';

// ── DEV MODE (deployed until Phase 10) ─────────────────────────────────────
// Anyone may read; any signed-in user may write. Cloud Functions and the
// seeder use the Admin SDK and bypass rules.
//
// The real per-collection rules live in firestore.production.rules. Each
// phase adds the rules for the collections it introduces there, with emulator
// tests in mobile/functions/test/rules/. Phase 10 deploys them (SRS §6.17).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

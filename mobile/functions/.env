# Non-secret parameters of the Cloud Functions (committed). Read by `firebase deploy`
# and by the Functions emulator, so neither prompts for them. Secrets never go here:
# they live in Secret Manager (`firebase functions:secrets:set NAME`) and, for the
# emulator only, in functions/.secret.local (git-ignored).
#
# Algolia search sync (SRS §5.8, §12 item 7) — see onProductWrite in src/index.ts.
# Leave ALGOLIA_APP_ID empty until the owner provides it: onProductWrite then keeps the
# derived query fields up to date and skips Algolia. The emulator never syncs to Algolia
# unless ALGOLIA_EMULATOR_SYNC=true is set (e.g. in functions/.env.local).
ALGOLIA_APP_ID=
ALGOLIA_INDEX_NAME=products

# App Check (SRS §8, Phase 10): set to true once the app, iOS app, web app and the
# dashboard are registered in Firebase App Check (and the debug tokens of test devices
# added), then redeploy the functions. See docs/RELEASE.md.
ENFORCE_APP_CHECK=false

# AI Gift Search (SRS §5.6) — Gemini on Vertex AI (location global) with the functions'
# service account: enable the Vertex AI API on goldengift-iq. Any current Gemini model id.
GEMINI_MODEL=gemini-3.5-flash-lite

# ZainCash (SRS §12 item 4, PROVISIONAL first online gateway) — see payments/zainCash.ts.
# test + empty merchant id = ZainCash's public sandbox merchant (no real money). For live
# payments: ZAINCASH_ENV=prod, the merchant id + wallet number from ZainCash, and the
# merchant secret in Secret Manager (`firebase functions:secrets:set ZAINCASH_SECRET`; the
# secret must exist before deploying, any placeholder will do while on the sandbox).
# ZAINCASH_RETURN_URL: empty = https://europe-west1-<project>.cloudfunctions.net/zainCashReturn.
ZAINCASH_ENV=test
ZAINCASH_MERCHANT_ID=
ZAINCASH_MSISDN=
ZAINCASH_RETURN_URL=

# Performance (SRS §8, Phase 10): warm instances of the checkout callables (placeOrder,
# createPaymentSession). 0 = scale to zero (no idle cost). At launch set 1 and redeploy
# those two functions to take the cold start out of "Place order" (billed while idle).
CHECKOUT_MIN_INSTANCES=0

# Store-review demo account (SRS AUTH-2): App Store / Play reviewers sign in with this
# number (E.164, e.g. +9647700000000) and the fixed code in the REVIEW_OTP_CODE secret
# (`firebase functions:secrets:set REVIEW_OTP_CODE`, six digits; it must exist before
# deploying sendOtp / verifyOtp). Nothing is sent to this number. Empty = off.
REVIEW_PHONE=
